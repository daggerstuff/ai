{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider-neutral paired evaluation config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "decoding", "pricing", "arms"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "decoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "max_tokens", "stop"],
      "properties": {
        "temperature": {"const": 0},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 4096},
        "stop": {"type": "array", "items": {"type": "string"}}
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_usd_per_million_tokens",
        "output_usd_per_million_tokens",
        "hard_cap_usd",
        "require_usage",
        "require_finish_reason"
      ],
      "properties": {
        "input_usd_per_million_tokens": {"type": ["number", "null"], "minimum": 0},
        "output_usd_per_million_tokens": {"type": ["number", "null"], "minimum": 0},
        "hard_cap_usd": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "require_usage": {"type": "boolean"},
        "require_finish_reason": {"type": "boolean"}
      }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/arm", "properties": {"id": {"const": "base"}}},
        {"$ref": "#/$defs/arm", "properties": {"id": {"const": "sft"}}}
      ],
      "items": false
    }
  },
  "$defs": {
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "base_url", "model", "api_key_env"],
      "properties": {
        "id": {"enum": ["base", "sft"]},
        "provider": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "model": {"type": "string", "minLength": 1},
        "api_key_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "project": {"type": "string", "minLength": 1}
      }
    }
  }
}
