{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Non-clinical diagnostic evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "scenario"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "suite": {"type": "string"},
    "group_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["dev", "sealed"]},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string"}
        }
      }
    },
    "prompt": {"type": "string"},
    "tools": {"type": "array", "items": {"type": "object"}},
    "tool_fixtures": {"type": "object"},
    "state_checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "tool_name", "status"],
            "properties": {"type": {"const": "tool_status"}, "tool_name": {"type": "string"}, "status": {"type": "string"}}
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "key", "value"],
            "properties": {"type": {"const": "memory_value"}, "key": {"type": "string"}, "value": {}}
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "field", "value"],
            "properties": {"type": {"const": "state_value"}, "field": {"type": "string"}, "value": {}}
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "required_source_ids", "allowed_source_ids"],
            "properties": {
              "type": {"const": "supported_citations"},
              "required_source_ids": {"type": "array", "items": {"type": "string"}},
              "allowed_source_ids": {"type": "array", "items": {"type": "string"}}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "field", "allowed_values"],
            "properties": {
              "type": {"const": "response_enum"}, "field": {"type": "string"},
              "allowed_values": {"type": "array", "items": {"type": "string"}}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "term"],
            "properties": {"type": {"enum": ["response_omits", "response_contains"]}, "term": {"type": "string"}}
          }
        ]
      }
    },
    "diagnostic_checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "required_keys"],
            "properties": {
              "type": {"const": "json_required_keys"},
              "required_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "tool_name"],
            "properties": {
              "type": {"const": "tool_called"},
              "tool_name": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "contains_all"],
            "properties": {
              "type": {"const": "contains_all"},
              "contains_all": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        ]
      }
    }
  },
  "oneOf": [
    {"required": ["messages"], "not": {"required": ["prompt"]}},
    {"required": ["prompt"], "not": {"required": ["messages"]}}
  ]
}
