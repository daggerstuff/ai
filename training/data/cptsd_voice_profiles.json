  "recovery_stages": {
    "awareness": {
      "label": "Awareness \u2014 Recognizing CPTSD Patterns",
      "description": "Beginning to understand that symptoms stem from complex trauma, recognizing survival responses and triggers"
    },
    "stabilization": {
      "label": "Stabilization \u2014 Building Safety and Regulation",
      "description": "Developing emotional regulation skills, creating safety, grounding techniques, building support systems"
    },
    "processing": {
      "label": "Processing \u2014 Working Through Trauma Memories",
      "description": "Gradually processing traumatic memories, understanding the past, working through grief and anger"
    },
    "integration": {
      "label": "Integration \u2014 Incorporating New Coping Skills",
      "description": "Integrating new understanding into daily life, building healthier relationships, practicing boundaries"
    },
    "thriving": {
      "label": "Thriving \u2014 Living Beyond Survival Mode",
      "description": "Moving from surviving to thriving, finding purpose, helping others, building a meaningful life"
    }
  }
