{
  "phase": "sft",
  "stage": 1,
  "model": {
    "base_model": "zai-org/glm-5.3-flash",
    "fallback_model": "Harbringer-24B",
    "target": "mental_health_specialization"
  },
  "training": {
    "framework": "unsloth",
    "method": "lora",
    "batch_size": 4,
    "gradient_accumulation_steps": 4,
    "learning_rate": 2e-5,
    "epochs": 1,
    "max_seq_length": 4096
  },
  "adapters": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "datasets": [
    {
      "name": "final_canonical_dataset",
      "path": "s3://pixel-data/final_dataset/",
      "weight": 1.0
    }
  ],
  "monitoring": {
    "wandb_project": "pixelated-empathy-lora",
    "log_steps": 10
  }
}
