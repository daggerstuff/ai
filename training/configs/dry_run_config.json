{
  "base_model": "deepseek-ai/DeepSeek-V4-Pro",
  "training_parameters": {
    "num_train_epochs": 1,
    "max_steps": 5,
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "learning_rate": 1e-4,
    "output_dir": "./output_dry_run"
  },
  "dataset_config": {
    "total_conversations": 100,
    "train_split": 0.8,
    "val_split": 0.2
  },
  "lora_config": {
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "lora_target_modules": ["q_proj", "v_proj"],
    "task_type": "CAUSAL_LM"
  },
  "h100_optimizations": {
    "bf16": false
  },
  "logging": {
    "logging_steps": 1
  }
}
