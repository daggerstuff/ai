[Unit]
Description=Pixelated training-infra MCP (PIX-5000)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vivi/pixelated/ai
Environment=PATH=/home/vivi/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TRAINING_MCP_ENV_FILE=/home/vivi/pixelated/ai/training/mcp/.env
ExecStart=/home/vivi/pixelated/ai/.venv/bin/python -m training.mcp
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
