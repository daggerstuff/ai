# Training-infra MCP environment (copy to .env, mode 600).
# Secrets live ONLY here (or the workspace .env). Agents get only URL + token.

# Service bind (localhost only; never 0.0.0.0)
TRAINING_MCP_HOST=127.0.0.1
TRAINING_MCP_PORT=8766

# Registry path. Leave unset for the default
# (<package>/state/jobs.db, i.e. ai/training/mcp/state/jobs.db). If you set it,
# use an ABSOLUTE path: a relative value resolves against the process CWD, so
# `state/jobs.db` silently points at a different database than the default.
# TRAINING_MCP_DB=/home/vivi/pixelated/ai/training/mcp/state/jobs.db

# Optional bearer token. If set, clients must send Authorization: Bearer <token>.
# Mirrors TRAINING_INFRA_MCP_TOKEN expected by agent connection files.
# TRAINING_MCP_TOKEN is the legacy alias and is only read if the name below is unset.
TRAINING_INFRA_MCP_TOKEN=

# --- Budget caps (enforced by submit_job; audited on rejection) -------------
# Reject a submit while this many jobs are already running/queued (1 = strict
# single-flight). Set 0 to disable the concurrency cap.
TRAINING_MCP_MAX_CONCURRENT_JOBS=1
# Reject a submit once this many jobs were requested today (imported history
# does not count).
TRAINING_MCP_DAILY_JOB_CAP=5
# Reject a submit once this month's requested spend would exceed this (USD).
TRAINING_MCP_MONTHLY_COST_CAP_USD=100.0

# How long a plan_hash stays submittable after plan_job (seconds, default 24h).
TRAINING_MCP_PLAN_TTL_SECONDS=86400

# --- Promotion gate policy (defaults applied when a caller omits them) ------
# Minimum sft-minus-base pass-rate delta required to promote.
TRAINING_MCP_GATE_MIN_DELTA=0.05
# Minimum absolute sft-arm pass rate required to promote.
TRAINING_MCP_GATE_MIN_PASS_RATE=0.5

# --- Provenance + safety ---------------------------------------------------
# Write terminal job outcomes to Foresight (0/false/no/off disables).
TRAINING_MCP_FORESIGHT=1
# Foresight MCP endpoint used for terminal-outcome memory writes.
FORESIGHT_URL=http://127.0.0.1:8764/mcp
# Explicit opt-in required before binding to a non-loopback address. Leave
# unset: remote binding is a deliberate, reviewed change, not a default.
TRAINING_MCP_ALLOW_REMOTE=

# --- Backends ---------------------------------------------------------------
WANDB_API_KEY=
WANDB_PROJECT=pixelated-empathy-kan28
WANDB_ENTITY=wutang
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=training

# OVH auth is file-based (~/.config/ovhai/config.json); no env var needed.
