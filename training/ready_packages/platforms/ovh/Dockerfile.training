# OVHcloud AI Training Dockerfile for Pixelated Empathy
# Optimized for MoE + LoRA training on L40S/H100 GPUs

# Build arguments
ARG PYTORCH_VERSION=2.5.1
ARG CUDA_VERSION=12.4
ARG PYTHON_VERSION=3.11

# Base image with CUDA support
FROM pytorch/pytorch:${PYTORCH_VERSION}-cuda${CUDA_VERSION}-cudnn9-runtime

# Metadata
LABEL maintainer="Pixelated Empathy Team"
LABEL description="OVHcloud AI Training image for therapeutic MoE model"
LABEL version="1.0.0"

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    CUDA_DEVICE_ORDER=PCI_BUS_ID \
    TRANSFORMERS_CACHE=/tmp/transformers_cache \
    HF_HOME=/tmp/huggingface \
    WANDB_DIR=/checkpoints/wandb

# Create non-root user (ubuntu) explicitly to match OVH standard
RUN useradd -m -s /bin/bash -u 42420 ubuntu || true

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    vim \
    htop \
    tmux \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create working directory
WORKDIR /app

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install \
    transformers>=4.42.0 \
    datasets>=2.19.0 \
    accelerate>=0.33.0 \
    peft>=0.11.0 \
    trl>=0.9.6 \
    bitsandbytes>=0.43.0 \
    sentencepiece>=0.1.99 \
    einops>=0.7.0 \
    wandb>=0.16.0 \
    scipy>=1.10.0 \
    scikit-learn>=1.3.0 \
    numpy>=1.24.0 \
    pandas>=2.0.0 \
    pyyaml>=6.0 \
    rich>=13.0.0 \
    tqdm>=4.65.0 \
    safetensors>=0.4.0 \
    google-genai \
    boto3>=1.34.0 \
    python-dotenv>=1.0.0

# Copy training code
COPY ai/core /app/ai/core/
COPY ai/utils /app/ai/utils/
COPY ai/lightning /app/ai/lightning/
COPY ai/training/defense_mechanisms /app/ai/training/defense_mechanisms/
COPY ai/training/ready_packages/scripts/batch_regenerate.py /app/ai/training/ready_packages/scripts/
COPY ai/training/ready_packages/models/moe_architecture.py /app/
COPY ai/training/ready_packages/tools/training_optimizer.py /app/
COPY ai/training/train_moe_h100.py /app/
COPY ai/training/ready_packages/platforms/ovh/train_ovh.py /app/
COPY ai/training/ready_packages/configs/hyperparameters/moe_training_config.json /app/config/

# Embed mission-critical datasets directly into the image (Golden Image strategy)
# This eliminates dependency on brittle OVH object storage volume mounts for input data.
COPY ai/data/acquired_datasets/mental_health_counseling.json /data/acquired/
COPY ai/data/acquired_datasets/cot_reasoning.json /data/acquired/
COPY ai/data/unified_training/train.json /data/lightning/


# Create necessary directories
RUN mkdir -p /app /data /checkpoints /tmp/transformers_cache /tmp/huggingface

# Set permissions (Explicitly using 42420 for OVH compliance)
RUN chmod +x /app/train_ovh.py && \
    chown -R 42420:42420 /app /data /checkpoints /tmp/transformers_cache /tmp/huggingface

# Set HOME (Mandatory for OVH custom images)
ENV HOME=/app

# Use the non-root user
USER ubuntu

# Default environment variables
ENV DATA_DIR=/data \
    CHECKPOINT_DIR=/checkpoints \
    CONFIG_PATH=/app/config/moe_training_config.json \
    MAX_TRAINING_HOURS=12 \
    GPU_MODEL=L40S

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import torch; assert torch.cuda.is_available()" || exit 1

# Default command
CMD ["python", "/app/train_ovh.py", "--config", "/app/config/moe_training_config.json"]
