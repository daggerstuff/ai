# Hindsight MCP Server Environment Variables
# Copy this file to .env.local and fill in the required values

# Required: Memory provider (use local_hindsight for local SQLite storage)
MEMORY_PROVIDER=local_hindsight

# Required: Path to the SQLite database file
HINDSIGHT_LOCAL_DB_PATH=/path/to/your/memory.db

# Required: Bank identifier for memory organization
HINDSIGHT_BANK_ID=default

# Required: Enable trust mode for local MCP (set to "true")
HINDSIGHT_MCP_STDIO_TRUST=true

# Required: Default user ID for the local agent
HINDSIGHT_COMPAT_DEFAULT_USER_ID=your-username

# Required: Actor ID for bearer token authentication
HINDSIGHT_COMPAT_BEARER_ACTOR_ID=local-hindsight-cli

# Required: JSON object with actor tokens (can be empty "{}")
LOCAL_MEMORY_ACTOR_TOKENS_JSON={}

# Required: JSON object with actor policies (can be empty "{}")
LOCAL_MEMORY_ACTOR_POLICIES_JSON={}

# Optional: Enable bearer token compatibility mode
HINDSIGHT_COMPAT_ENABLE_BEARER=true
