# Pixelated shared local memory service
# Copy to a host-local env file and set real secrets before starting the service.

MEMORY_PROVIDER=local_hindsight
HINDSIGHT_LOCAL_DB_PATH=/var/lib/pixelated-memory/hindsight.db
HINDSIGHT_BANK_ID=pixelated-staging
MEMORY_SERVER_PORT=5003
MEMORY_HEALTH_URL=http://127.0.0.1:5003/health
MEMORY_DISK_WARN_PERCENT=85
MEMORY_BACKUP_DIR=/var/backups/pixelated-memory
MEMORY_BACKUP_RETENTION_DAYS=14

# Actor credentials are HMAC secrets keyed by actor id.
LOCAL_MEMORY_ACTOR_TOKENS_JSON={"subconscious-staging":"replace-with-long-random-secret"}

# Every actor must have an explicit scope policy.
LOCAL_MEMORY_ACTOR_POLICIES_JSON={"subconscious-staging":{"allowed_user_prefixes":["vivi","service-","agent-"]}}
