# Pixelated shared memory service configuration template.
#
# Copy this file to /etc/pixelated/pixelated-memory.env or a local .env file
# before starting the Hindsight MCP server, the product memory gateway, or
# installing the systemd unit.

MEMORY_PROVIDER=local_hindsight
HINDSIGHT_LOCAL_DB_PATH=${HOME}/.hindsight/pixelated.db
HINDSIGHT_BANK_ID=pixelated
HINDSIGHT_MCP_STDIO_TRUST=true
HINDSIGHT_COMPAT_ENABLE_BEARER=true
HINDSIGHT_COMPAT_BEARER_ACTOR_ID=local-hindsight-cli
HINDSIGHT_COMPAT_DEFAULT_USER_ID=vivi

# Replace the placeholder secrets below with local-only values before use.
LOCAL_MEMORY_ACTOR_TOKENS_JSON='{"api-server":"13fef82f0bedce212158507ccf7d66856a16d64fb5b7fc00d0b39fb05d7776f0","local-hindsight-cli":"64256384a7f60fdb049625046914e15c394a7931a4ad8f8184421231efad3fcd"}'
LOCAL_MEMORY_ACTOR_POLICIES_JSON='{"api-server":{"allowed_user_prefixes":["vivi","service-","agent-","pixelated"]},"local-hindsight-cli":{"allowed_users":["vivi"]}}'

# Product-facing gateway settings. The app uses these to sign requests into the
# shared service over HTTP.
MEMORY_SERVICE_BASE_URL=http://127.0.0.1:54321
MEMORY_SERVICE_ACTOR_ID=api-server
MEMORY_SERVICE_ACTOR_SECRET=7f1936ceac38f3a850488629863b7b4e155468fe040957cf1601587b51e45c8c

# Backward-compatible aliases used by older subconscious callers.
SUBCONSCIOUS_MEMORY_BASE_URL=${MEMORY_SERVICE_BASE_URL}
SUBCONSCIOUS_MEMORY_ACTOR_ID=${MEMORY_SERVICE_ACTOR_ID}
SUBCONSCIOUS_MEMORY_ACTOR_SECRET=${MEMORY_SERVICE_ACTOR_SECRET}
