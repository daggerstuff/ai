# Letta Configuration  
LETTA_API_KEY=${LETTA_API_KEY:-}
LETTA_BASE_URL=https://api.letta.ai
LETTA_MODE=whisper
# LETTA_AGENT_ID=agent-xxxxx  # Set after first run

# Subconscious Model Selection (Nvidia NIM)
