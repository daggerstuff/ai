# Subconscious Staging Configuration
# Shared-memory client settings for the staging stack.

# LLM configuration
SUBCONSCIOUS_MODEL=meta/llama-4-maverick-17b-128e-instruct
SUBCONSCIOUS_BASE_URL=https://integrate.api.nvidia.com

# Shared memory service configuration
SUBCONSCIOUS_MEMORY_PROVIDER=shared_service
SUBCONSCIOUS_MEMORY_BASE_URL=${SUBCONSCIOUS_MEMORY_BASE_URL:-http://127.0.0.1:54321}
SUBCONSCIOUS_MEMORY_ACTOR_ID=${SUBCONSCIOUS_MEMORY_ACTOR_ID:-subconscious-staging}
SUBCONSCIOUS_MEMORY_ACTOR_SECRET=${SUBCONSCIOUS_MEMORY_ACTOR_SECRET:-}
HINDSIGHT_BANK_ID=pixelated-staging

# Client behavior
SUBCONSCIOUS_ENABLED=true
MAX_CONTENT_LENGTH=100000
ENABLE_PII_REDACTION=true
CONFIG_PERMISSIONS=0600
